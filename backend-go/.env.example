# ===== Tapiito Go 服务环境变量样例 =====
# 复制为 .env 后按环境填写；生产环境必须全部显式设置，禁止沿用默认值。

APP_ENV=dev
PUBLIC_ADDR=:8080
ADMIN_ADDR=:8081

# --- MySQL ---
DB_DSN=nfc_user:nfc_pass@tcp(127.0.0.1:3306)/nfc?charset=utf8mb4&parseTime=true&loc=Local
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=20
DB_CONN_MAX_LIFETIME=5m
# 并发闸门：读/写独立信号量，写侧预留容量给管理面
DB_READ_CONCURRENCY=80
DB_WRITE_CONCURRENCY=20
DB_QUEUE_LIMIT=200
DB_QUEUE_TIMEOUT=200ms
DB_QUERY_TIMEOUT=3s

# --- Redis：缓存实例（允许淘汰）与控制实例（不可丢）必须分开 ---
REDIS_CACHE_ADDR=127.0.0.1:6379
REDIS_CACHE_PASSWORD=
REDIS_CACHE_DB=0
REDIS_CACHE_POOL=200

REDIS_CONTROL_ADDR=127.0.0.1:6380
REDIS_CONTROL_PASSWORD=
REDIS_CONTROL_DB=0
REDIS_CONTROL_POOL=100

# --- JWT（生产必须 >= 32 位随机串，且不得为默认值）---
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=tapiito

# --- 限流 ---
RL_GLOBAL_QPS=400
RL_PUBLIC_READ_RPS=10
RL_PUBLIC_READ_BURST=20
RL_PUBLIC_WRITE_RPS=2
RL_PUBLIC_WRITE_BURST=5
RL_ADMIN_RPS=20
RL_ADMIN_BURST=40
RL_LOGIN_PER_MINUTE=5
BL_WINDOW_SECONDS=60
BL_HITS=20
BL_TTL_MINUTES=10

# --- 缓存 TTL ---
CACHE_PAGE_TTL_MINUTES=10
CACHE_PAGE_JITTER_SECONDS=60
CACHE_MISS_TTL_SECONDS=30

# --- Bloom ---
BLOOM_KEY_V1=bloom:v1
BLOOM_KEY_V2=bloom:v2
BLOOM_CURRENT_KEY=bloom:current
BLOOM_BUILDING_KEY=bloom:building
BLOOM_DELTA_KEY=bloom:delta
BLOOM_ERROR_RATE=0.001
BLOOM_CAPACITY=1000000
BLOOM_DELTA_TTL_HOURS=24

# --- 其他 ---
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=*
TRUST_PROXY=true
# 首次启动创建管理员；生产必须设置密码，否则拒绝启动
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
